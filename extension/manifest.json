{
  "manifest_version": 3,
  "name": "Veritas Universal — Multimodal AI Verification Engine",
  "version": "2.7.0",
  "description": "Cross-Platform Real-Time Multimodal AI Verification & Deepfake Detection for X, Instagram, Facebook & YouTube. Founder: Md. Mahmudul Hoque.",
  "author": "Md. Mahmudul Hoque <mahmudulhoque934@gmail.com>",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://*.facebook.com/*",
    "https://*.instagram.com/*",
    "https://*.youtube.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Veritas Universal - Md. Mahmudul Hoque"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://*.facebook.com/*",
        "https://*.instagram.com/*",
        "https://*.youtube.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
