{
  "manifest_version": 3,
  "name": "Veritas for X",
  "version": "1.1.0",
  "description": "Autonomous Real-Time Multimodal AI Verification Engine for X. Powered by Gemini. Founder: Md. Mahmudul Hoque.",
  "author": "Md. Mahmudul Hoque <mahmudulhoque934@gmail.com>",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Veritas for X - Md. Mahmudul Hoque"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
