{
  "manifest_version": 3,
  "name": "Veritas-X — Multimodal AI Verification Engine",
  "version": "3.4.3",
  "description": "Cross-Platform Real-Time Multimodal AI Verification & Deepfake Detection for X, Facebook, Instagram, TikTok, and Threads. Founder: Md. Mahmudul Hoque.",
  "author": "Md. Mahmudul Hoque <mahmudulhoque934@gmail.com>",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*",
    "*://*.threads.net/*",
    "*://*.threads.com/*",
    "*://*.youtube.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Veritas-X - Md. Mahmudul Hoque"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*",
        "*://*.threads.net/*",
        "*://*.threads.com/*",
        "*://*.youtube.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
